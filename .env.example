# Copy to .env (setup.ps1 does this and fills in random secrets). Never commit .env.

# --- Database ---
# embedded : backend starts a real local PostgreSQL binary (no Docker needed; data in ./data/postgres)
# external : use DB_URL (e.g. Docker Compose PostgreSQL started by start.ps1, or your own install)
DB_MODE=embedded
EMBEDDED_DB_PORT=55432
EMBEDDED_DB_DATA_DIR=data/postgres
USE_DOCKER_DB=false
DB_URL=jdbc:postgresql://localhost:5432/bms
DB_USERNAME=bms
DB_PASSWORD=change-me

# --- Service-to-service secrets (32+ random characters each) ---
INTERNAL_API_TOKEN=change-me-python-to-java-token-32chars
ANALYTICS_SERVICE_TOKEN=change-me-java-to-python-token-32chars
ANALYTICS_URL=http://127.0.0.1:8090
JAVA_INTERNAL_URL=http://127.0.0.1:8080

# --- First administrator (created only if no admin exists) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@bank.example
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=true

# --- Demo data (development only) ---
DEMO_SEED=true
DEMO_PASSWORD=change-me

# --- Misc ---
BUSINESS_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false

# --- Customer sign-up ---
# Lets anyone create a customer login + account from the sign-in page
SELF_REGISTRATION=true
# Google sign-in: OAuth client id (Web application) from https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins must include http://localhost:5173 . Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
